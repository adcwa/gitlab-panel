{
  "name": "@local/gitlab-panel",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "GitLab repositories, native task worktrees and manually confirmed Draft MR delivery for DSH",
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "client.js", "host/**", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "API.md", "PRODUCT.md", "DESIGN.md", "WORKFLOW.md"],
  "scripts": { "test": "node --test tests/*.test.js" },
  "dependencies": { "zod": "4.1.12" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-workspace"] }
  }
}
